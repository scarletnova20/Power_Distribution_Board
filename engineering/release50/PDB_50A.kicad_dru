(version 1)
# Standard four-layer process, 1 oz outer / 2 oz inner, 2026-09-15.
# Supersedes the LionCircuits 2 oz all-layer screen, which was unachievable:
# the TI land patterns for U1 (0.220 mm), U3 (0.200 mm) and U5 (0.200 mm)
# cannot meet a 0.254 mm spacing rule. Outer copper reduced to 1 oz so that
# a 6 mil track/space class applies; 50 A path moved onto 2 oz inner layers.
# Preserve stricter existing component-hole rules; no exclusions.
(rule "6mil width" (constraint track_width (min 0.1524mm)))
(rule "6mil spacing" (constraint clearance (min 0.1524mm)))
(rule "PTH component annulus" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint annular_width (min 0.254mm)))
(rule "PTH to other copper" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.30mm)))
(rule "Component hole spacing" (condition "A.Type == 'Pad' && B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
